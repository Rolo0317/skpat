---
import type { AjustesLugar, DetalleFecha, OfertaUbicacion } from '~/lib/data'
import Seccion from '../ui/Seccion.astro'
import BotonNeon from '../ui/BotonNeon.astro'
import Icono from '../ui/Icono.astro'
import MapaPalcos from '../ui/MapaPalcos.astro'
import CamposPersona from '../ui/CamposPersona.astro'
import { ESTADOS_UBICACION, NOMBRE_OFERTA } from '../contenido/ubicaciones'
import { contactosWhatsapp, whatsappPrincipal } from '../utilidades/contacto'
import { fechaCorta, formatoCOP } from '../utilidades/formato'

interface Props {
  /** Una entrada por fecha del evento activo (el plano cambia de estado según la fecha). */
  detalles: DetalleFecha[]
  ajustes: AjustesLugar
}

const TAMANO_ICONO = 18
const { detalles, ajustes } = Astro.props
const conPlano = detalles.filter((detalle) => detalle.ubicaciones.length > 0)
const ofertas: OfertaUbicacion[] = detalles.find((detalle) => detalle.oferta.ubicaciones.length > 0)?.oferta.ubicaciones ?? []
const [contactoPrincipal] = contactosWhatsapp(ajustes)
const titulo = detalles[0]?.evento.titulo
const enlaceDudas = whatsappPrincipal(ajustes, `Hola Skpat VIP, quiero reservar un palco o una mesa${titulo ? ` para ${titulo}` : ''}.`)
const idPanel = (indice: number) => `plano-fecha-${indice}`
const idPestana = (indice: number) => `pestana-fecha-${indice}`
const LEYENDA = (['disponible', 'reservado', 'vendido'] as const).map((estado) => ({ estado, rotulo: ESTADOS_UBICACION[estado].rotulo }))
---
<Seccion
  id="palcos"
  titulo="Palcos y mesas VIP"
  intro="Elige tu puesto en el plano, mira qué incluye y apártalo. El pago se cierra por WhatsApp con un gestor."
  class="palcos-seccion"
>
  <div class="palcos" data-palcos>
    <div class="palcos__plano">
      {
        conPlano.length > 1 && (
          <div role="tablist" aria-label="Fecha" class="palcos__fechas" data-pestanas>
            {conPlano.map((detalle, indice) => (
              <button
                type="button"
                role="tab"
                id={idPestana(indice)}
                aria-controls={idPanel(indice)}
                aria-selected={indice === 0 ? 'true' : 'false'}
                tabindex={indice === 0 ? 0 : -1}
                class="palcos__fecha"
              >
                {fechaCorta(detalle.evento.fecha)}
              </button>
            ))}
          </div>
        )
      }
      {
        conPlano.map((detalle, indice) => (
          <div
            id={idPanel(indice)}
            role={conPlano.length > 1 ? 'tabpanel' : undefined}
            aria-labelledby={conPlano.length > 1 ? idPestana(indice) : undefined}
            hidden={indice > 0}
          >
            <MapaPalcos detalle={detalle} />
          </div>
        ))
      }
      {
        conPlano.length > 0 ? (
          <ul class="leyenda" aria-label="Convenciones">
            {LEYENDA.map(({ estado, rotulo }) => (
              <li class:list={['leyenda__item', `leyenda__item--${estado}`]}>{rotulo}</li>
            ))}
          </ul>
        ) : (
          <p class="palcos__sin-plano">El plano de esta fecha aún no está publicado. Aparta tu palco o mesa con un gestor.</p>
        )
      }
      <p class="solo-lector" aria-live="polite" data-plano-anuncio></p>
    </div>

    <div class="palcos__ofertas">
      {
        ofertas.map((oferta) => (
          <article class:list={['oferta', `oferta--${oferta.tipo}`]}>
            <h3 class="oferta__nombre">{NOMBRE_OFERTA[oferta.tipo]}</h3>
            <p class="oferta__precio cifra">{formatoCOP(oferta.precioCentavos)}</p>
            <ul class="oferta__incluye">
              {oferta.incluye.map((item) => (
                <li><Icono nombre="check" tamano={TAMANO_ICONO} />{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
      <BotonNeon href={enlaceDudas} externo variante={conPlano.length > 0 ? 'secundario' : 'primario'} icono="whatsapp">
        Reservar con un gestor
      </BotonNeon>
    </div>

    <dialog class="reserva" aria-labelledby="reserva-titulo" data-reserva-dialogo data-whatsapp-respaldo={contactoPrincipal?.whatsapp}>
      <div class="reserva__caja">
        <button type="button" class="reserva__cerrar" aria-label="Cerrar" data-dialogo-cerrar><Icono nombre="cerrar" /></button>
        <p class="reserva__fecha" data-campo="fecha"></p>
        <h3 id="reserva-titulo" class="reserva__titulo" data-campo="nombre"></h3>
        <p class="reserva__precio cifra" data-campo="precio"></p>
        <p class="reserva__capacidad" data-campo="capacidad"></p>
        <ul class="reserva__incluye" aria-label="Incluye" data-campo-incluye></ul>

        <form class="reserva__formulario" data-reserva-formulario>
          <CamposPersona prefijo="reserva" />
          <p class="reserva__error" role="alert" data-reserva-error></p>
          <BotonNeon tipo="submit" icono="whatsapp">Apartar y pagar por WhatsApp</BotonNeon>
          <p class="reserva__nota">Queda pendiente de pago hasta que el gestor lo confirme. Al confirmar te llega un QR por persona al correo.</p>
        </form>

        <div class="reserva__exito" data-reserva-exito hidden>
          <p class="reserva__titulo">¡Apartado!</p>
          <p>Tu <span data-campo="nombre"></span> queda pendiente de pago. Termina la compra con el gestor por WhatsApp.</p>
          <BotonNeon href="#" externo icono="whatsapp" data-reserva-whatsapp>Continuar por WhatsApp</BotonNeon>
          <p class="reserva__nota">Referencia: <span class="cifra" data-campo="referencia"></span></p>
        </div>
      </div>
    </dialog>
  </div>
</Seccion>

<script>
  import { iniciarReservas } from '../ui/reservaPalcos'
  import { iniciarPestanas } from '../ui/pestanas'

  document.querySelectorAll<HTMLElement>('[data-palcos]').forEach(iniciarReservas)
  document.querySelectorAll<HTMLElement>('[data-pestanas]').forEach(iniciarPestanas)
</script>

<style>
  :global(.palcos-seccion) {
    background:
      radial-gradient(80% 50% at 0% 100%, color-mix(in oklab, var(--primario) 30%, transparent), transparent 70%),
      var(--fondo);
  }
  .palcos { display: grid; gap: 2.5rem; }
  .palcos__plano { display: grid; gap: 1rem; }

  .palcos__fechas { display: flex; gap: 0.5rem; justify-content: center; }
  .palcos__fecha {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: var(--fondo-2);
    color: var(--tinta);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .palcos__fecha::first-letter { text-transform: uppercase; }
  .palcos__fecha[aria-selected='true'] { background: var(--degradado-oro); color: var(--fondo); border-color: transparent; }

  .leyenda { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; padding: 0; margin: 0; list-style: none; font-size: 0.9rem; color: var(--tinta-suave); }
  .leyenda__item { display: flex; align-items: center; gap: 0.4rem; }
  .leyenda__item::before { content: ''; width: 0.9rem; height: 0.9rem; border-radius: 0.25rem; border: 2px solid var(--primario); background: var(--fondo-3); }
  .leyenda__item--reservado::before { border-style: dashed; opacity: 0.6; }
  .leyenda__item--vendido::before { border-color: var(--color-skpat-red); background: linear-gradient(45deg, transparent 42%, var(--color-skpat-red) 42% 58%, transparent 58%); }
  .palcos__sin-plano { padding: 1.5rem; border: 1px dashed color-mix(in oklab, var(--primario) 50%, transparent); border-radius: var(--radio); }

  .palcos__ofertas { display: grid; gap: 1rem; align-content: start; }
  .oferta {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radio);
    border: 1px solid color-mix(in oklab, var(--primario) 45%, var(--linea));
    background: linear-gradient(160deg, color-mix(in oklab, var(--primario) 16%, var(--fondo-2)), var(--fondo-2) 60%);
  }
  .oferta__nombre { font-family: var(--fuente-display); font-weight: 900; font-size: clamp(2rem, 8vw, 2.75rem); line-height: 0.9; text-transform: uppercase; color: var(--tinta); }
  .oferta__precio { font-family: var(--fuente-display); font-weight: 900; font-size: 2.25rem; line-height: 1; color: var(--primario-claro); }
  .oferta__incluye { display: grid; gap: 0.35rem; padding: 0; margin: 0; list-style: none; color: var(--color-skpat-text); }
  .oferta__incluye li { display: flex; align-items: center; gap: 0.5rem; }
  .oferta__incluye :global(svg) { color: var(--primario); flex: none; }

  .reserva {
    width: min(100% - 2rem, 30rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid color-mix(in oklab, var(--primario) 45%, var(--linea));
    border-radius: var(--radio);
    background: var(--fondo-2);
    color: var(--color-skpat-text);
    box-shadow: var(--sombra-profunda);
  }
  .reserva::backdrop { background: rgb(0 0 0 / 0.75); backdrop-filter: blur(4px); }
  .reserva__caja { position: relative; display: grid; gap: 0.75rem; padding: 1.5rem 1.25rem; }
  .reserva__cerrar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--linea);
    border-radius: 50%;
    background: var(--fondo);
    color: var(--tinta);
    cursor: pointer;
  }
  .reserva__fecha { padding-right: 3rem; font-size: 0.9rem; font-weight: 500; color: var(--acento-claro); }
  .reserva__titulo { font-family: var(--fuente-display); font-weight: 900; font-size: 2.5rem; line-height: 0.95; text-transform: uppercase; color: var(--tinta); }
  .reserva__precio { font-family: var(--fuente-display); font-weight: 900; font-size: 2.25rem; line-height: 1; color: var(--primario-claro); }
  .reserva__capacidad { color: var(--tinta-suave); }
  .reserva__incluye { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0; list-style: none; }
  .reserva__incluye :global(li) { padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid var(--linea); font-size: 0.85rem; color: var(--tinta); }
  .reserva__formulario { display: grid; gap: 1rem; margin-top: 0.5rem; }
  .reserva__error { min-height: 1.2em; color: var(--color-skpat-red); font-weight: 700; }
  .reserva__error:empty { display: none; }
  .reserva__nota { font-size: 0.85rem; color: var(--tinta-suave); }
  .reserva__exito { display: grid; gap: 1rem; }
  .reserva__exito[hidden] { display: none; }
  .reserva__formulario[hidden] { display: none; }

  @media (min-width: 60rem) {
    .palcos { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  }
</style>

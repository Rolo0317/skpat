---
import type { EventoPublico } from '~/lib/data'
import LaseresCanvas from '../ui/LaseresCanvas.astro'
import CuentaRegresiva from '../ui/CuentaRegresiva.astro'
import BotonNeon from '../ui/BotonNeon.astro'
import { NEGOCIO, RUTAS_APP } from '../contenido/negocio'
import { partesDeFecha } from '../utilidades/formato'
import { estaSucediendo } from '../utilidades/agenda'
import Logo from '../ui/Logo.astro'

interface Props {
  proximo: EventoPublico | null
  ahora: Date
}

const { proximo, ahora } = Astro.props
const fecha = proximo ? partesDeFecha(proximo.fecha) : null
---
<section class="portada" aria-labelledby="portada-titulo">
  <LaseresCanvas />
  <div class="contenedor portada__contenido">
    <div class="portada__marca">
      <h1 id="portada-titulo" class="portada__titulo">
        <Logo class="portada__logo" prioritario sizes="(min-width: 48rem) 36rem, 100vw" />
      </h1>
      <p class="portada__lema">
        Electrónica y guaracha hasta las 4 AM. {NEGOCIO.horario.dias} en la 93, Bogotá.
      </p>
    </div>

    <aside class="portada__panel" aria-labelledby="proxima-noche">
      {
        proximo && fecha ? (
          <>
            <p id="proxima-noche" class="portada__rotulo">
              Próxima noche · <time datetime={proximo.fecha.toISOString()}>{fecha.completa}, {fecha.hora}</time>
            </p>
            <p class="portada__evento">{proximo.titulo}</p>
            <CuentaRegresiva objetivo={proximo.fecha} ahora={ahora} enVivo={estaSucediendo(proximo, ahora)} />
            <div class="portada__acciones">
              <BotonNeon href={RUTAS_APP.comprar(proximo.id)} icono="flecha">Comprar entrada</BotonNeon>
              <BotonNeon href="#cartelera" variante="secundario">Ver cartelera</BotonNeon>
            </div>
          </>
        ) : (
          <>
            <p id="proxima-noche" class="portada__rotulo">{NEGOCIO.horario.dias} · {NEGOCIO.horario.texto}</p>
            <p class="portada__evento">La próxima fecha sale muy pronto</p>
            <p class="portada__nota">Crea tu cuenta y sé de los primeros en comprar cuando abra la boletería.</p>
            <div class="portada__acciones">
              <BotonNeon href={RUTAS_APP.registro} icono="flecha">Crear cuenta</BotonNeon>
              <BotonNeon href="#tarifas" variante="secundario">Ver tarifas</BotonNeon>
            </div>
          </>
        )
      }
    </aside>
  </div>
</section>

<style>
  .portada {
    position: relative;
    min-height: min(100svh, 56rem);
    display: flex;
    align-items: flex-end;
    padding-block: 6rem 2rem;
    isolation: isolate;
  }
  .portada__contenido { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }

  .portada__titulo { margin: 0; }
  .portada :global(.portada__logo) {
    width: min(100%, 36rem);
    filter: drop-shadow(0 0.5rem 2.5rem color-mix(in oklab, var(--primario) 45%, transparent));
  }
  .portada__lema { margin-top: 1.25rem; max-width: 34ch; font-size: clamp(1.1rem, 3.6vw, 1.35rem); color: var(--tinta); }

  .portada__panel {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radio);
    border: 1px solid color-mix(in oklab, var(--primario) 45%, transparent);
    background: color-mix(in oklab, var(--fondo) 82%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: var(--sombra-profunda);
  }
  .portada__rotulo { font-size: 0.9rem; color: var(--azul-claro); font-weight: 500; }
  .portada__rotulo time::first-letter { text-transform: uppercase; }
  .portada__evento { font-family: var(--fuente-display); font-weight: 900; font-size: clamp(2rem, 8vw, 2.75rem); line-height: 0.95; text-transform: uppercase; color: var(--tinta); text-wrap: balance; }
  .portada__nota { color: var(--tinta-suave); }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .portada__acciones > :global(*) { flex: 1 1 auto; }

  @media (min-width: 64rem) {
    .portada { padding-bottom: 4rem; }
    .portada__contenido { grid-template-columns: 1.4fr minmax(22rem, 1fr); align-items: end; gap: 3rem; }
    .portada__panel { padding: 1.75rem; }
  }
</style>

---
import { principalDe, type EventoActivo } from '../utilidades/agenda'
import ArteEvento from './ArteEvento.astro'
import BotonNeon from './BotonNeon.astro'
import { RUTAS_APP } from '../contenido/negocio'
import { centavosPublicados } from '../utilidades/etapas'
import { fechaCorta, fechasEnTexto, partesDeFecha, precioVisible } from '../utilidades/formato'

interface Props {
  activo: EventoActivo
  destacado?: boolean
}

const POCOS_CUPOS = 25
const { activo, destacado = false } = Astro.props
const principal = principalDe(activo)
const precio = principal.precioVigente
const fechas = activo.fechas.map((evento) => ({
  evento,
  partes: partesDeFecha(evento.fecha),
  agotado: evento.cuposDisponibles <= 0,
  quedanPocos: evento.cuposDisponibles > 0 && evento.cuposDisponibles <= POCOS_CUPOS,
}))
---
<article class:list={['cartel', { 'cartel--destacado': destacado }]}>
  <ArteEvento class="cartel__arte" semilla={principal.id} imagenUrl={principal.imagenUrl} alt={`Flyer de ${activo.titulo}`} prioridad={destacado} />
  <ul class="cartel__fechas" aria-label="Fechas">
    {
      fechas.map(({ evento, partes }) => (
        <li>
          <time class="cartel__fecha" datetime={evento.fecha.toISOString()}>
            <span class="cartel__dia">{partes.dia}</span>
            <span class="cartel__numero cifra">{partes.numero}</span>
            <span class="cartel__mes">{partes.mes}</span>
          </time>
        </li>
      ))
    }
  </ul>
  <div class="cartel__cuerpo">
    <h3 class="cartel__titulo">{activo.titulo}</h3>
    <p class="cartel__cuando">{fechasEnTexto(activo.fechas.map((evento) => evento.fecha))} · desde las {fechas[0]?.partes.hora}</p>
    {principal.lineup.length > 0 && <p class="cartel__lineup">{principal.lineup.join(' · ')}</p>}
    <p class="cartel__meta">
      {principal.genero && <span>{principal.genero}</span>}
      {principal.esVip && <span class="cartel__vip">VIP</span>}
    </p>
    {destacado && principal.descripcion && <p class="cartel__descripcion">{principal.descripcion}</p>}
    {
      precio && (
        <p class="cartel__precio">
          <span class="cartel__etapa">{precio.nombre}</span>
          <span class="cifra">{precioVisible(centavosPublicados(precio))}</span>
        </p>
      )
    }
    <ul class="cartel__compra">
      {
        fechas.map(({ evento, partes, agotado, quedanPocos }) => (
          <li>
            {agotado ? (
              <span class="cartel__aviso">{fechaCorta(evento.fecha)}: agotado</span>
            ) : (
              <BotonNeon href={RUTAS_APP.comprar(evento.id)} variante={destacado ? 'primario' : 'secundario'} icono="flecha">
                {`Entrada ${partes.dia} ${partes.numero}`}<span class="solo-lector"> de {partes.mesLargo}, {activo.titulo}</span>
              </BotonNeon>
            )}
            {quedanPocos && <span class="cartel__aviso">Últimos {evento.cuposDisponibles} cupos</span>}
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .cartel {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.25rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--linea);
  }
  .cartel :global(.cartel__arte) { display: none; }

  .cartel__fechas { display: flex; flex-direction: column; gap: 0.75rem; padding: 0; margin: 0; list-style: none; }
  .cartel__fecha {
    display: flex; flex-direction: column; align-items: center;
    min-width: 4.25rem;
    font-family: var(--fuente-display); font-weight: 700; text-transform: uppercase; line-height: 1;
    color: var(--tinta-suave);
  }
  .cartel__numero { font-size: 2.75rem; font-weight: 900; color: var(--tinta); }
  .cartel__dia, .cartel__mes { font-size: 1rem; letter-spacing: 0.08em; }
  .cartel__dia { color: var(--acento-claro); }

  .cartel__cuerpo { display: grid; gap: 0.5rem; min-width: 0; }
  .cartel__titulo { font-family: var(--fuente-display); font-weight: 900; font-size: clamp(1.9rem, 7vw, 2.6rem); line-height: 0.95; text-transform: uppercase; color: var(--tinta); text-wrap: balance; }
  .cartel__cuando { color: var(--tinta); font-weight: 500; }
  .cartel__cuando::first-letter { text-transform: uppercase; }
  .cartel__lineup { color: var(--primario-claro); font-weight: 500; }
  .cartel__meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; color: var(--tinta-suave); font-size: 0.95rem; }
  .cartel__meta:empty { display: none; }
  .cartel__vip { color: var(--oro); font-weight: 700; letter-spacing: 0.08em; }
  .cartel__descripcion { max-width: 60ch; color: var(--color-skpat-text); white-space: pre-line; }
  .cartel__precio { display: flex; flex-direction: column; font-family: var(--fuente-display); font-weight: 700; font-size: 1.75rem; line-height: 1.1; color: var(--tinta); }
  .cartel__etapa { font-family: var(--fuente-texto); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--acento-claro); }
  .cartel__compra { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; margin: 0.5rem 0 0; list-style: none; }
  .cartel__compra li { display: grid; gap: 0.25rem; justify-items: start; }
  .cartel__aviso { font-size: 0.9rem; font-weight: 700; color: var(--acento-claro); }

  .cartel--destacado { grid-template-columns: 1fr; padding-top: 0; border-top: 0; }
  .cartel--destacado :global(.cartel__arte) {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    box-shadow: var(--sombra-profunda);
  }
  .cartel--destacado .cartel__fechas { position: absolute; top: 1rem; left: 1rem; flex-direction: row; }
  .cartel--destacado .cartel__fecha { padding: 0.75rem 0.6rem; border-radius: var(--radio-pequeno); background: var(--fondo); }
  .cartel--destacado .cartel__titulo { font-size: clamp(2.5rem, 10vw, 4rem); }

  @media (min-width: 48rem) {
    .cartel :global(.cartel__arte) { display: block; width: 7rem; aspect-ratio: 4 / 5; border-radius: var(--radio-pequeno); }
    .cartel { grid-template-columns: auto 7rem 1fr; align-items: center; }
    .cartel__fechas { grid-column: 1; grid-row: 1; }
    .cartel--destacado { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2.5rem; align-items: center; }
    .cartel--destacado :global(.cartel__arte) { width: auto; }
  }
</style>

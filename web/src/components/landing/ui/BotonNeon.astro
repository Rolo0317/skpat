---
import Icono, { type NombreIcono } from './Icono.astro'

/** Con href es un enlace; sin href es un <button> (envío de formularios, acciones en la página). */
type Props = {
  href?: string
  tipo?: 'button' | 'submit'
  variante?: 'primario' | 'secundario'
  icono?: NombreIcono
  externo?: boolean
  /** Nombre de archivo: el enlace descarga en vez de navegar. */
  descargar?: string
  class?: string
} & { [atributo: `data-${string}`]: string | boolean | undefined }

const TAMANO_ICONO = 18
const { href, tipo = 'button', variante = 'primario', icono, externo = false, descargar, class: clase, ...atributosDatos } = Astro.props
const atributosExternos = externo ? { target: '_blank', rel: 'noopener noreferrer' } : {}
const clases = ['boton', `boton--${variante}`, clase]
---
{
  href ? (
    <a href={href} class:list={clases} download={descargar} {...atributosExternos} {...atributosDatos}>
      <span class="boton__texto"><slot /></span>
      {icono && <Icono nombre={icono} tamano={TAMANO_ICONO} />}
    </a>
  ) : (
    <button type={tipo} class:list={clases} {...atributosDatos}>
      <span class="boton__texto"><slot /></span>
      {icono && <Icono nombre={icono} tamano={TAMANO_ICONO} />}
    </button>
  )
}

<style>
  .boton {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.25rem;
    padding: 0.85rem 1.6rem;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: translate 0.35s var(--curva-salida), box-shadow 0.35s var(--curva-salida), background-color 0.2s, border-color 0.2s;
  }
  .boton :global(svg) { flex: none; transition: translate 0.35s var(--curva-salida); }
  .boton:hover :global(svg) { translate: 3px 0; }
  .boton:hover { translate: 0 -2px; }
  .boton:active { translate: 0 1px; transition-duration: 0.1s; }
  .boton:disabled { opacity: 0.6; cursor: progress; translate: none; }

  /* Barrido de luz: un haz cruza el botón al pasar el puntero, como un cabezal que lo alumbra. */
  .boton::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / 0.55) 48%, transparent 66%);
    translate: -120% 0;
    transition: translate 0.7s var(--curva-salida);
    pointer-events: none;
  }
  .boton:hover::after, .boton:focus-visible::after { translate: 120% 0; }

  .boton--primario {
    color: #120c02;
    background: var(--degradado-oro);
    box-shadow: var(--brillo-oro);
  }
  .boton--primario:hover {
    box-shadow: 0 1rem 2.5rem -0.75rem color-mix(in oklab, var(--acento) 95%, transparent);
  }

  .boton--secundario {
    color: var(--tinta);
    border: 1px solid color-mix(in oklab, var(--tinta) 26%, transparent);
    background: color-mix(in oklab, var(--fondo) 55%, transparent);
  }
  .boton--secundario::after { background: linear-gradient(105deg, transparent 30%, color-mix(in oklab, var(--azul) 45%, transparent) 50%, transparent 70%); }
  .boton--secundario:hover { border-color: var(--azul-claro); box-shadow: var(--brillo-azul); }

  @media (prefers-reduced-motion: reduce) {
    .boton, .boton:hover, .boton:active { translate: none; }
    .boton::after { display: none; }
  }
</style>

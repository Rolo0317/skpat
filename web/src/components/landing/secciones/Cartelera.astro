---
import type { Cartelera } from '../utilidades/agenda'
import Seccion from '../ui/Seccion.astro'
import EventoCartel from '../ui/EventoCartel.astro'
import BotonNeon from '../ui/BotonNeon.astro'
import { NEGOCIO } from '../contenido/negocio'

interface Props {
  cartelera: Cartelera
}

/** Solo el evento activo (y, si los hay, otros activos próximos): la web no muestra fechas pasadas ni ficticias. */
const { cartelera } = Astro.props
const { destacado, otros } = cartelera
---
<Seccion id="cartelera" titulo={destacado ? 'Evento activo' : 'Próxima fecha'}>
  {
    destacado ? (
      <div class="cartelera">
        <EventoCartel activo={destacado} destacado />
        {otros.length > 0 && (
          <div class="cartelera__resto">
            {otros.map((activo) => <EventoCartel activo={activo} />)}
          </div>
        )}
      </div>
    ) : (
      <div class="cartelera__vacia">
        <p>Estamos armando el próximo evento. Las fechas salen primero en Instagram.</p>
        <div class="cartelera__acciones">
          <BotonNeon href={NEGOCIO.redes.instagram.url} externo icono="instagram">Seguir {NEGOCIO.redes.instagram.usuario}</BotonNeon>
        </div>
      </div>
    )
  }
</Seccion>

<style>
  .cartelera { display: grid; gap: 3rem; }
  .cartelera__resto { display: grid; }
  .cartelera__vacia {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
    padding: 2rem;
    border: 1px dashed color-mix(in oklab, var(--primario) 50%, transparent);
    border-radius: var(--radio);
    font-size: 1.1rem;
  }
  .cartelera__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>

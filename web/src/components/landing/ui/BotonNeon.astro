---
import Icono, { type NombreIcono } from './Icono.astro'

/** Con href es un enlace; sin href es un <button> (envío de formularios, acciones en la página). */
type Props = {
  href?: string
  tipo?: 'button' | 'submit'
  variante?: 'primario' | 'secundario'
  icono?: NombreIcono
  externo?: boolean
  /** Nombre de archivo: el enlace descarga en vez de navegar. */
  descargar?: string
  class?: string
} & { [atributo: `data-${string}`]: string | boolean | undefined }

const TAMANO_ICONO = 18
const { href, tipo = 'button', variante = 'primario', icono, externo = false, descargar, class: clase, ...atributosDatos } = Astro.props
const atributosExternos = externo ? { target: '_blank', rel: 'noopener noreferrer' } : {}
const clases = ['boton', `boton--${variante}`, clase]
---
{
  href ? (
    <a href={href} class:list={clases} download={descargar} {...atributosExternos} {...atributosDatos}>
      <slot />
      {icono && <Icono nombre={icono} tamano={TAMANO_ICONO} />}
    </a>
  ) : (
    <button type={tipo} class:list={clases} {...atributosDatos}>
      <slot />
      {icono && <Icono nombre={icono} tamano={TAMANO_ICONO} />}
    </button>
  )
}

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0.85rem 1.5rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: transform 0.35s var(--curva-salida), box-shadow 0.35s var(--curva-salida), background-color 0.2s;
  }
  .boton :global(svg) { transition: transform 0.35s var(--curva-salida); }
  .boton:hover :global(svg) { transform: translateX(3px); }
  .boton:active { transform: scale(0.98); }
  .boton:disabled { opacity: 0.6; cursor: progress; }

  .boton--primario {
    color: var(--fondo);
    background: var(--degradado-oro);
    box-shadow: 0 0.5rem 1.5rem -0.5rem color-mix(in oklab, var(--primario) 70%, transparent);
  }
  .boton--primario:hover {
    background: var(--acento-claro);
    box-shadow: 0 0.75rem 2rem -0.5rem color-mix(in oklab, var(--acento) 90%, transparent);
  }

  .boton--secundario {
    color: var(--tinta);
    border: 1px solid color-mix(in oklab, var(--tinta) 30%, transparent);
    background: color-mix(in oklab, var(--fondo) 60%, transparent);
  }
  .boton--secundario:hover { border-color: var(--primario-claro); background: color-mix(in oklab, var(--primario) 18%, var(--fondo)); }
</style>

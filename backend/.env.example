# Backend env — NEVER commit real values
# Generate ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# SQLite database path (relative to cwd or absolute)
DATABASE_PATH=./data/skpat.db

# JWT secrets (must be >= 32 chars)
JWT_SECRET=your-long-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Encryption (AES-256-GCM) — 64 hex chars = 32 bytes
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# Server
PORT=3001
NODE_ENV=development

# CORS — comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

---
import type { AjustesLugar } from '~/lib/data'
import Escenario from '~/components/escenario/Escenario.astro'
import CuentaRegresiva from '../ui/CuentaRegresiva.astro'
import BotonNeon from '../ui/BotonNeon.astro'
import Logo from '../ui/Logo.astro'
import { NEGOCIO, RUTAS_APP } from '../contenido/negocio'
import { fechaCorta, fechasEnTexto } from '../utilidades/formato'
import { estaSucediendo, principalDe, type EventoActivo } from '../utilidades/agenda'
import { whatsappPrincipal } from '../utilidades/contacto'

interface Props {
  activo: EventoActivo | null
  ajustes: AjustesLugar
  ahora: Date
}

const { activo, ajustes, ahora } = Astro.props
const principal = activo ? principalDe(activo) : null
const enlaceProximaFecha = whatsappPrincipal(ajustes, 'Hola Skpat VIP, ¿cuándo es la próxima fecha?')
---
<section class="portada" aria-labelledby="portada-titulo">
  <Escenario class="portada__escenario" />
  <div class="portada__velo" aria-hidden="true"></div>

  <div class="contenedor portada__contenido">
    <div class="portada__marca">
      <h1 id="portada-titulo" class="portada__titulo">
        <Logo class="portada__logo" prioritario sizes="(min-width: 64rem) 30rem, 80vw" />
      </h1>
      <p class="portada__lema">
        Electrónica y guaracha {NEGOCIO.horario.texto.toLowerCase()}. {NEGOCIO.horario.dias} en el sector {NEGOCIO.direccion.sector}, {NEGOCIO.direccion.ciudad}.
      </p>
    </div>

    <aside class="portada__pase" aria-labelledby="evento-activo">
      {
        activo && principal ? (
          <>
            <p id="evento-activo" class="portada__rotulo">
              <span class="portada__punto" aria-hidden="true"></span>
              Evento activo · {fechasEnTexto(activo.fechas.map((evento) => evento.fecha))}
            </p>
            <p class="portada__evento">{activo.titulo}</p>
            <CuentaRegresiva objetivo={principal.fecha} ahora={ahora} enVivo={estaSucediendo(principal, ahora)} />
            <div class="portada__acciones">
              {activo.fechas.map((evento) => (
                <BotonNeon href={RUTAS_APP.comprar(evento.id)} icono="flecha">Entrada {fechaCorta(evento.fecha)}</BotonNeon>
              ))}
              <BotonNeon href="#palcos" variante="secundario">Palcos y mesas</BotonNeon>
            </div>
          </>
        ) : (
          <>
            <p id="evento-activo" class="portada__rotulo">{NEGOCIO.horario.dias} · {NEGOCIO.horario.texto}</p>
            <p class="portada__evento">La próxima fecha sale muy pronto</p>
            <p class="portada__nota">Escríbenos y te avisamos apenas abra la venta por etapas.</p>
            <div class="portada__acciones">
              <BotonNeon href={enlaceProximaFecha} externo icono="whatsapp">Avísame por WhatsApp</BotonNeon>
              <BotonNeon href="#agencia" variante="secundario">Agencia y cursos de DJ</BotonNeon>
            </div>
          </>
        )
      }
    </aside>
  </div>
</section>

<style>
  /* Celular: el escenario es una ventana arriba y el pase sube sobre el público. */
  .portada {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding-block: 52svh max(2.5rem, var(--reserva-asistente, 0px));
    background: var(--sala);
  }
  .portada :global(.portada__escenario) { inset: 0 0 auto; height: 72svh; }
  .portada__velo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in oklab, var(--sala) 70%, transparent) 0, transparent 5.5rem),
      linear-gradient(to top, var(--sala) 28%, color-mix(in oklab, var(--sala) 70%, transparent) 46%, transparent 64%);
  }
  .portada__contenido { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }

  .portada__titulo { margin: 0; }
  .portada :global(.portada__logo) {
    width: min(80vw, 30rem);
    filter: drop-shadow(0 0.75rem 2.5rem color-mix(in oklab, var(--primario) 50%, transparent));
  }
  .portada__lema {
    margin-top: 1rem;
    max-width: 30ch;
    font-size: clamp(1.1rem, 3.8vw, 1.4rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--tinta);
    text-wrap: pretty;
  }

  /* El pase: superficie sólida (no vidrio) con canto de luz arriba, como una pulsera VIP. */
  .portada__pase {
    position: relative;
    display: grid;
    gap: 1.1rem;
    padding: 1.4rem;
    border: 1px solid var(--linea-luz);
    border-radius: var(--radio);
    background: color-mix(in oklab, var(--fondo-2) 94%, transparent);
    box-shadow: var(--sombra-profunda);
  }
  .portada__pase::before {
    content: '';
    position: absolute;
    inset: -1px 1.5rem auto;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--acento), var(--azul), transparent);
  }
  .portada__rotulo { display: flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; color: var(--acento-claro); font-weight: 600; }
  .portada__punto { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--color-skpat-green); box-shadow: 0 0 0.6rem var(--color-skpat-green); }
  .portada__evento {
    font-family: var(--fuente-impacto);
    font-weight: 800;
    /* Unbounded es muy ancha: el tamaño se limita para que la palabra más larga quepa en el pase. */
    font-size: clamp(1.3rem, 5.4vw, 1.8rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--tinta);
    text-wrap: balance;
  }
  .portada__nota { color: var(--tinta-suave); }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .portada__acciones > :global(*) { flex: 1 1 auto; }

  @media (prefers-reduced-motion: no-preference) {
    .portada__punto { animation: punto-vivo calc(var(--tiempo) * 2) ease-out infinite; }
  }
  @keyframes punto-vivo { 0% { opacity: 1; } 50% { opacity: 0.35; } }

  /* Escritorio: el escenario ocupa todo el primer viewport y el contenido se apoya sobre el público. */
  @media (min-width: 64rem) {
    .portada { min-height: max(100svh, 46rem); padding-block: 8rem 3.5rem; }
    .portada :global(.portada__escenario) { inset: 0; height: auto; }
    .portada__velo {
      background:
        linear-gradient(to bottom, color-mix(in oklab, var(--sala) 75%, transparent) 0, transparent 7rem),
        linear-gradient(to top, var(--sala) 4%, color-mix(in oklab, var(--sala) 55%, transparent) 26%, transparent 46%),
        linear-gradient(to right, color-mix(in oklab, var(--sala) 55%, transparent), transparent 40%);
    }
    .portada__contenido { grid-template-columns: minmax(0, 1.25fr) minmax(23rem, 26rem); align-items: end; gap: 4rem; }
    .portada__pase { padding: 1.75rem; }
  }
</style>

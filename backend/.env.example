# Backend env — NEVER commit real values
# Generate ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# SQLite database path (relative to cwd or absolute)
DATABASE_PATH=./data/skpat.db

# JWT secrets (must be >= 32 chars)
JWT_SECRET=your-long-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Encryption (AES-256-GCM) — 64 hex chars = 32 bytes
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# Server
PORT=3001
NODE_ENV=development

# CORS — comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# File uploads (events flyers) — files written to backend/uploads/, served at /uploads/*

# AI Chat agent — Anthropic Claude
# Get key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_MODEL=claude-haiku-4-5-20251001

# Email / SMTP — OPTIONAL
# If SMTP_HOST, SMTP_USER, SMTP_PASS are missing, ticket emails are logged to console (dev mode).
# For Gmail in production: enable 2FA, generate App Password at
# https://myaccount.google.com/apppasswords, use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=skpatvip@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=noreply@skpatvip.com

# Frontend base URL — used in email links and CORS
FRONTEND_URL=http://localhost:5173

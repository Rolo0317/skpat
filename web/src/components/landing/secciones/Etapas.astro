---
import type { AjustesLugar, DetalleFecha } from '~/lib/data'
import type { EventoActivo } from '../utilidades/agenda'
import Seccion from '../ui/Seccion.astro'
import BotonNeon from '../ui/BotonNeon.astro'
import CuentaRegresiva from '../ui/CuentaRegresiva.astro'
import { RUTAS_APP } from '../contenido/negocio'
import { armarEtapas, etapaVigente } from '../utilidades/etapas'
import { fechaCorta, precioVisible } from '../utilidades/formato'
import { whatsappPrincipal } from '../utilidades/contacto'

interface Props {
  activo: EventoActivo | null
  /** Oferta de la fecha principal del evento activo. */
  detalle: DetalleFecha | null
  ajustes: AjustesLugar
  ahora: Date
}

const { activo, detalle, ajustes, ahora } = Astro.props
const etapas = detalle ? armarEtapas(detalle.oferta, detalle.evento, ahora) : []
const vigente = etapaVigente(etapas)
const ROTULO_ESTADO = { vencida: 'Agotada', vigente: 'Vigente', proxima: 'Siguiente' } as const
const enlaceDudas = whatsappPrincipal(ajustes, `Hola Skpat VIP, quiero saber los precios de ${activo?.titulo ?? 'la próxima fecha'}.`)
---
<Seccion
  id="etapas"
  titulo="Compra temprano, paga menos"
  intro="La entrada general se vende por etapas: cuando se acaba una, sube el precio. El día del evento aplica taquilla."
  class="etapas-seccion"
>
  {
    activo && vigente ? (
      <div class="etapas">
        <div class="etapas__lectura">
          <p class="etapas__evento">{activo.titulo}</p>
          <p class="etapas__rotulo">Precio de hoy · {vigente.nombre}</p>
          <p class="etapas__precio cifra">{precioVisible(vigente.precioCentavos)}</p>
          {vigente.terminaEn && (
            <div class="etapas__cuenta">
              <p class="etapas__rotulo">Cambia de etapa en</p>
              <CuentaRegresiva
                objetivo={vigente.terminaEn}
                ahora={ahora}
                enVivo={false}
                etiqueta={`Tiempo para que termine ${vigente.nombre}`}
                textoFinal="Cambió la etapa"
              />
            </div>
          )}
          <div class="etapas__acciones">
            {activo.fechas.map((fecha) => (
              <BotonNeon href={RUTAS_APP.comprar(fecha.id)} icono="flecha">
                Entrada {fechaCorta(fecha.fecha)}
              </BotonNeon>
            ))}
          </div>
        </div>

        <ol class="etapas__lista">
          {etapas.map((etapa) => (
            <li class:list={['etapa', `etapa--${etapa.estado}`]} aria-current={etapa.estado === 'vigente' ? 'true' : undefined}>
              <span class="etapa__nombre">{etapa.nombre}</span>
              <span class="etapa__estado">{ROTULO_ESTADO[etapa.estado]}</span>
              <span class="etapa__precio cifra">{precioVisible(etapa.precioCentavos)}</span>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="etapas__vacio">
        <p>Los precios por etapa salen con cada evento. Pregúntale a un gestor por la próxima fecha.</p>
        <BotonNeon href={enlaceDudas} externo icono="whatsapp">Preguntar por WhatsApp</BotonNeon>
      </div>
    )
  }
</Seccion>

<style>
  :global(.etapas-seccion) {
    background:
      radial-gradient(70% 60% at 100% 0%, color-mix(in oklab, var(--acento) 22%, transparent), transparent 70%),
      var(--fondo-2);
    border-block: 1px solid var(--linea);
  }
  .etapas { display: grid; gap: 2.5rem; }
  .etapas__lectura { display: grid; gap: 0.75rem; }
  .etapas__evento { font-family: var(--fuente-display); font-weight: 900; font-size: 1.5rem; text-transform: uppercase; color: var(--primario-claro); }
  .etapas__rotulo { color: var(--tinta-suave); font-weight: 500; }
  .etapas__precio {
    font-family: var(--fuente-display);
    font-weight: 900;
    font-size: clamp(4.5rem, 24vw, 8rem);
    line-height: 0.9;
    color: var(--tinta);
    text-shadow: 0 0.4rem 2rem color-mix(in oklab, var(--acento) 55%, transparent);
  }
  .etapas__cuenta { display: grid; gap: 0.5rem; max-width: 24rem; }
  .etapas__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .etapas__lista { display: grid; gap: 0.5rem; padding: 0; margin: 0; list-style: none; }
  .etapa {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radio-pequeno);
    border: 1px solid var(--linea);
    background: color-mix(in oklab, var(--fondo) 70%, transparent);
  }
  .etapa__nombre { font-family: var(--fuente-display); font-weight: 900; font-size: 1.6rem; text-transform: uppercase; color: var(--tinta); }
  .etapa__estado { grid-row: 2; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinta-suave); }
  .etapa__precio { grid-row: span 2; font-family: var(--fuente-display); font-weight: 700; font-size: 1.9rem; color: var(--tinta); }
  .etapa--vigente { border-color: var(--primario); background: color-mix(in oklab, var(--primario) 18%, var(--fondo)); box-shadow: 0 1rem 2rem -1.25rem color-mix(in oklab, var(--primario) 80%, transparent); }
  .etapa--vigente .etapa__estado { color: var(--acento-claro); }
  .etapa--vencida { opacity: 0.5; }
  .etapa--vencida .etapa__precio { text-decoration: line-through; }

  .etapas__vacio {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 40rem;
    padding: 2rem;
    border: 1px dashed color-mix(in oklab, var(--primario) 50%, transparent);
    border-radius: var(--radio);
    font-size: 1.1rem;
  }

  @media (min-width: 56rem) {
    .etapas { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); column-gap: 4rem; align-items: center; }
  }
</style>

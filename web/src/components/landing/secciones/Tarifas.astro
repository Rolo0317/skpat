---
import Seccion from '../ui/Seccion.astro'
import { DURACION_NOCHE_MIN, TARIFAS, estadoDeLaNoche, finDeTarifaMin, horaDeLaNoche, inicioDeTarifaMin, tarifaEnMinuto } from '../contenido/tarifas'
import { formatoCOP } from '../utilidades/formato'
import { PASO_MINUTOS, descripcionParaLector, minutoInicial, porcentajeDeNoche, textoDeEstado } from '../ui/lineaTarifas'

interface Props {
  ahora: Date
}

const { ahora } = Astro.props
const estado = estadoDeLaNoche(ahora)
const minuto = minutoInicial(estado)
const seleccionada = tarifaEnMinuto(minuto)

const tramos = TARIFAS.map((tarifa, indice) => ({
  tarifa,
  ancho: porcentajeDeNoche(finDeTarifaMin(indice) - inicioDeTarifaMin(tarifa)),
}))
const marcas = [...TARIFAS.map(inicioDeTarifaMin), DURACION_NOCHE_MIN].map((minutoMarca) => ({
  posicion: porcentajeDeNoche(minutoMarca),
  hora: horaDeLaNoche(minutoMarca).replace(':00', ''),
}))
const variables = estado.tipo === 'abierto' ? `--ahora: ${porcentajeDeNoche(estado.minutoDeNoche)}%` : undefined
---
<Seccion
  id="tarifas"
  titulo="Llega temprano, paga menos"
  intro="El cover depende de la hora a la que entras. Mueve la línea de la noche y mira cuánto pagarías."
  class="tarifas-seccion"
>
  <div class="tarifas" data-linea-tarifas data-abierto={String(estado.tipo === 'abierto')} style={variables}>
    <div class="tarifas__lectura">
      <p class="tarifas__estado" data-estado-texto>{textoDeEstado(estado)}</p>
      <p class="tarifas__precio cifra" data-precio>{formatoCOP(seleccionada.precioCentavos)}</p>
      <p class="tarifas__nombre" data-nombre>Tarifa {seleccionada.nombre} · {seleccionada.rango}</p>
    </div>

    <div class="linea">
      <div class="linea__barra" aria-hidden="true">
        {
          tramos.map(({ tarifa, ancho }) => (
            <span class:list={['linea__tramo', `linea__tramo--${tarifa.id}`]} style={`flex-basis: ${ancho}%`} data-tarifa={tarifa.id} data-activa={tarifa.id === seleccionada.id ? '' : undefined} />
          ))
        }
        <span class="linea__ahora"><span>Ahora</span></span>
      </div>
      <label class="solo-lector" for="hora-llegada">¿A qué hora llegas?</label>
      <input
        id="hora-llegada"
        class="linea__control"
        type="range"
        min="0"
        max={DURACION_NOCHE_MIN}
        step={PASO_MINUTOS}
        value={minuto}
        aria-valuetext={descripcionParaLector(minuto)}
        data-control
      />
      <ol class="linea__marcas" aria-hidden="true">
        {marcas.map(({ posicion, hora }) => <li style={`left: ${posicion}%`}>{hora}</li>)}
      </ol>
    </div>

    <ul class="tarifas__lista">
      {
        TARIFAS.map((tarifa) => (
          <li class:list={['tarifa', `tarifa--${tarifa.id}`]} data-tarifa={tarifa.id} data-activa={tarifa.id === seleccionada.id ? '' : undefined}>
            <span class="tarifa__nombre">{tarifa.nombre}</span>
            <span class="tarifa__rango">{tarifa.rango}</span>
            <span class="tarifa__precio cifra">{formatoCOP(tarifa.precioCentavos)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Seccion>

<script>
  import { iniciarLineaTarifas } from '../ui/lineaTarifas'

  document.querySelectorAll<HTMLElement>('[data-linea-tarifas]').forEach(iniciarLineaTarifas)
</script>

<style>
  :global(.tarifas-seccion) {
    background:
      radial-gradient(70% 60% at 100% 0%, color-mix(in oklab, var(--acento) 22%, transparent), transparent 70%),
      var(--fondo-2);
    border-block: 1px solid var(--linea);
  }
  .tarifas { --color-madrugador: var(--azul); --color-regular: var(--primario); --color-noche-alta: var(--acento); display: grid; gap: 2.5rem; }

  .tarifas__estado { color: var(--azul-claro); font-weight: 500; min-height: 1.6em; }
  .tarifas__precio {
    font-family: var(--fuente-display);
    font-weight: 900;
    font-size: clamp(4.5rem, 24vw, 8rem);
    line-height: 0.9;
    color: var(--tinta);
    text-shadow: 0 0.4rem 2rem color-mix(in oklab, var(--acento) 55%, transparent);
  }
  .tarifas__nombre { margin-top: 0.5rem; font-size: 1.1rem; color: var(--tinta); }

  .linea { position: relative; padding-top: 1.75rem; }
  .linea__barra { position: relative; display: flex; height: 4rem; border-radius: var(--radio-pequeno); overflow: visible; gap: 3px; }
  .linea__tramo { height: 100%; border-radius: 6px; opacity: 0.35; transition: opacity 0.4s var(--curva-salida), transform 0.4s var(--curva-salida); }
  .linea__tramo--madrugador { background: var(--color-madrugador); }
  .linea__tramo--regular { background: var(--color-regular); }
  .linea__tramo--noche-alta { background: linear-gradient(90deg, var(--color-noche-alta), color-mix(in oklab, var(--color-noche-alta) 40%, var(--primario))); }
  .linea__tramo[data-activa] { opacity: 1; transform: scaleY(1.08); }

  .linea__ahora { display: none; position: absolute; top: -1.75rem; bottom: -0.25rem; left: var(--ahora); width: 2px; background: var(--tinta); }
  .linea__ahora span { position: absolute; top: 0; left: 0.4rem; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--tinta); }
  .tarifas[data-abierto='true'] .linea__ahora { display: block; }

  .linea__control {
    position: absolute;
    inset: 1.75rem 0 auto;
    width: 100%;
    height: 4rem;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: grab;
  }
  .linea__control:active { cursor: grabbing; }
  .linea__control::-webkit-slider-runnable-track { height: 4rem; background: transparent; }
  .linea__control::-moz-range-track { height: 4rem; background: transparent; }
  .linea__control::-webkit-slider-thumb {
    appearance: none;
    width: 1.75rem;
    height: 4.75rem;
    margin-top: -0.375rem;
    border-radius: 999px;
    border: 3px solid var(--fondo);
    background: var(--tinta);
    box-shadow: 0 0.5rem 1.25rem -0.25rem rgb(0 0 0 / 0.7);
  }
  .linea__control::-moz-range-thumb {
    width: 1.75rem;
    height: 4.75rem;
    border-radius: 999px;
    border: 3px solid var(--fondo);
    background: var(--tinta);
  }
  .linea__control:focus-visible { outline: none; }
  .linea__control:focus-visible::-webkit-slider-thumb { outline: 3px solid var(--azul-claro); outline-offset: 2px; }
  .linea__control:focus-visible::-moz-range-thumb { outline: 3px solid var(--azul-claro); outline-offset: 2px; }

  .linea__marcas { position: relative; height: 1.5rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .linea__marcas li { position: absolute; transform: translateX(-50%); font-size: 0.8rem; color: var(--tinta-suave); white-space: nowrap; }
  .linea__marcas li:first-child { transform: none; }
  .linea__marcas li:last-child { transform: translateX(-100%); }

  .tarifas__lista { display: grid; gap: 0.5rem; padding: 0; margin: 0; list-style: none; }
  .tarifa {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radio-pequeno);
    border: 1px solid var(--linea);
    background: color-mix(in oklab, var(--fondo) 70%, transparent);
    transition: border-color 0.3s, background-color 0.3s;
  }
  .tarifa__nombre { font-family: var(--fuente-display); font-weight: 900; font-size: 1.6rem; text-transform: uppercase; color: var(--tinta); }
  .tarifa__rango { grid-row: 2; color: var(--tinta-suave); font-size: 0.95rem; }
  .tarifa__precio { grid-row: span 2; font-family: var(--fuente-display); font-weight: 700; font-size: 1.9rem; color: var(--tinta); }
  .tarifa[data-activa] { border-color: var(--tarifa-color); background: color-mix(in oklab, var(--tarifa-color) 16%, var(--fondo)); }
  .tarifa--madrugador { --tarifa-color: var(--color-madrugador); }
  .tarifa--regular { --tarifa-color: var(--color-regular); }
  .tarifa--noche-alta { --tarifa-color: var(--color-noche-alta); }

  @media (min-width: 56rem) {
    .tarifas { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); column-gap: 4rem; align-items: end; }
    .linea { grid-column: 1 / -1; grid-row: 2; }
    .tarifas__lista { grid-template-columns: repeat(3, 1fr); grid-row: 1; grid-column: 2; }
  }
</style>

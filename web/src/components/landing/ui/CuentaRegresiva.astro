---
import { tiempoRestante, type UnidadTiempo } from './cuentaRegresiva'

interface Props {
  objetivo: Date
  ahora: Date
  enVivo: boolean
  /** Qué mide el reloj (para lectores de pantalla). */
  etiqueta?: string
  /** Lo que se muestra cuando el reloj llega a cero. */
  textoFinal?: string
}

const { objetivo, ahora, enVivo, etiqueta = 'Tiempo para que empiece', textoFinal = 'Está pasando ahora' } = Astro.props
const inicial = tiempoRestante(objetivo, ahora)
const UNIDADES: { clave: UnidadTiempo; unidad: string }[] = [
  { clave: 'dias', unidad: 'días' },
  { clave: 'horas', unidad: 'horas' },
  { clave: 'minutos', unidad: 'min' },
  { clave: 'segundos', unidad: 'seg' },
]
---
<div class="cuenta" data-cuenta-regresiva data-objetivo={objetivo.toISOString()} data-estado={enVivo ? 'en-vivo' : 'contando'}>
  <p class="cuenta__vivo"><span class="cuenta__punto"></span>{textoFinal}</p>
  <ol class="cuenta__reloj" aria-label={etiqueta}>
    {
      UNIDADES.map(({ clave, unidad }) => (
        <li class="cuenta__celda">
          <span class="cuenta__cifra cifra" data-unidad={clave}>{inicial[clave]}</span>
          <span class="cuenta__etiqueta">{unidad}</span>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { iniciarCuentaRegresiva } from './cuentaRegresiva'

  document.querySelectorAll<HTMLElement>('[data-cuenta-regresiva]').forEach(iniciarCuentaRegresiva)
</script>

<style>
  .cuenta__reloj { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
  .cuenta__celda {
    display: flex; flex-direction: column; align-items: center;
    padding: 0.6rem 0.25rem 0.5rem;
    border-radius: var(--radio-pequeno);
    background: color-mix(in oklab, var(--fondo) 75%, var(--primario));
  }
  .cuenta__cifra { font-family: var(--fuente-display); font-weight: 900; font-size: clamp(2rem, 9vw, 2.75rem); line-height: 1; color: var(--tinta); }
  .cuenta__etiqueta { font-size: 0.75rem; color: var(--tinta-suave); text-transform: uppercase; letter-spacing: 0.08em; }

  .cuenta__vivo { display: none; align-items: center; gap: 0.6rem; font-family: var(--fuente-display); font-weight: 900; font-size: 2rem; text-transform: uppercase; color: var(--acento-claro); }
  .cuenta__punto { width: 0.75rem; height: 0.75rem; border-radius: 50%; background: var(--acento); animation: latido 0.94s ease-out infinite; }
  .cuenta[data-estado='en-vivo'] .cuenta__vivo { display: flex; }
  .cuenta[data-estado='en-vivo'] .cuenta__reloj { display: none; }

  @keyframes latido {
    from { box-shadow: 0 0 0 0 color-mix(in oklab, var(--acento) 70%, transparent); }
    to { box-shadow: 0 0 0 0.75rem transparent; }
  }
</style>

---
import { variablesDeArte } from '../utilidades/arteGenerativo'

interface Props {
  semilla: string
  imagenUrl: string | null
  alt: string
  prioridad?: boolean
  class?: string
}

const { semilla, imagenUrl, alt, prioridad = false, class: clase } = Astro.props
---
<div class:list={['arte', clase]} style={variablesDeArte(semilla)}>
  <span class="arte__rayos" aria-hidden="true"></span>
  {
    imagenUrl && (
      <img
        class="arte__imagen"
        src={imagenUrl}
        alt={alt}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
        onerror="this.remove()"
      />
    )
  }
</div>

<style>
  /* El arte generativo siempre está debajo: si el flyer no carga, el evento sigue viéndose único. */
  .arte {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at var(--arte-x) var(--arte-y), color-mix(in oklab, var(--arte-a) 85%, transparent), transparent 55%),
      linear-gradient(var(--arte-angulo), color-mix(in oklab, var(--arte-b) 70%, var(--fondo)), var(--fondo) 75%);
  }
  .arte__rayos {
    position: absolute;
    inset: -50%;
    background: repeating-conic-gradient(from var(--arte-angulo) at var(--arte-x) var(--arte-y),
      color-mix(in oklab, var(--tinta) 14%, transparent) 0deg 1.5deg,
      transparent 1.5deg 14deg);
    mix-blend-mode: overlay;
  }
  .arte__imagen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
